# Agentic File Search MCP defaults for MLP Copilot.
#
# Copy this file to .env, or run:
#   scripts/init-skill.sh

# Local knowledge root. The MCP server will not read outside this path.
FS_EXPLORER_MCP_ROOT=/path/to/mlpcopilot-workspace/knowledge

# DuckDB index file. DB search works without embeddings by using keyword chunks.
FS_EXPLORER_DB_PATH=/path/to/mlpcopilot-workspace/knowledge/fs-explorer.duckdb

# OpenAI-compatible model endpoint used by the bundled single-tool MCP agent.
FS_EXPLORER_OPENAI_COMPAT_BASE_URL=http://127.0.0.1:8000/v1
FS_EXPLORER_OPENAI_COMPAT_MODEL=local-model
# FS_EXPLORER_OPENAI_COMPAT_API_KEY=your_api_key_here

# Indexed search policy. The server performs deterministic stale checks and
# refreshes the DB before querying when files are new, modified, or deleted.
FS_EXPLORER_AGENT_USE_INDEX=1
FS_EXPLORER_MCP_ALLOW_INDEXING=1
FS_EXPLORER_MCP_AUTO_REFRESH_INDEX=1
FS_EXPLORER_MCP_ALLOW_EMBEDDINGS=0
FS_EXPLORER_MCP_ALLOW_METADATA=0
FS_EXPLORER_MCP_DISCOVER_SCHEMA=0
FS_EXPLORER_MCP_INDEX_WORKERS=4

# Tool-call timeout for long document reads/summaries.
FS_EXPLORER_AGENT_TIMEOUT=120

# MCP Streamable HTTP transport defaults.
FS_EXPLORER_MCP_TRANSPORT=streamable-http
FS_EXPLORER_MCP_HTTP_HOST=127.0.0.1
FS_EXPLORER_MCP_HTTP_PORT=8765
FS_EXPLORER_MCP_HTTP_PATH=/mcp

# Optional: Google Gemini API key for the upstream original CLI/workflow.
# The OpenAI-compatible MCP agent above does not require this.
# GOOGLE_API_KEY=your_api_key_here

# Optional: dedicated key for langextract metadata mode.
# If unset, indexing will fall back to GOOGLE_API_KEY.
# LANGEXTRACT_API_KEY=your_api_key_here

# Optional: override langextract model used by `explore index --with-metadata`.
# FS_EXPLORER_LANGEXTRACT_MODEL=gemini-3-flash-preview

# FS_EXPLORER_MCP_SCHEMA_NAME=
